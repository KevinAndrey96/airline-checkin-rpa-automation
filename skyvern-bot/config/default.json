{
  "skyvern": {
    "apiUrl": "http://localhost:8000/v1",
    "pollIntervalMs": 5000,
    "taskTimeoutMs": 1800000,
    "maxSteps": 50,
    "engine": "skyvern-2.0",
    "proxyLocation": "NONE"
  },
  "copa": {
    "name": "Copa Airlines",
    "code": "copa",
    "mode": "workflow",
    "workflowId": "",
    "workflowRunWith": "code",
    "workflowAiFallback": true,
    "checkInUrl": "https://checkin.copaair.com/",
    "boardingPassDir": "./boarding_passes/copa"
  },
  "csv": {
    "path": "./passengers.csv",
    "encoding": "utf-8",
    "backup": false,
    "incrementalSave": true,
    "airlineFilter": "copa"
  },
  "processing": {
    "delayBetweenPassengersMs": 5000,
    "failureReviewDelayMs": 15000
  },
  "logging": {
    "level": "info",
    "console": true,
    "file": true,
    "logDir": "./logs",
    "appLogFile": "skyvern-app.log",
    "errorLogFile": "skyvern-errors.log"
  }
}
