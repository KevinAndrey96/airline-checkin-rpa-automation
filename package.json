{
  "name": "typescript-playwright-airline-checkin-rpa",
  "version": "2.0.0",
  "description": "Automatización RPA del check-in web de aerolíneas para agencias de viajes: Playwright para Avianca y Skyvern para Copa, con manifiesto CSV validado y pasabordos organizados.",
  "keywords": [
    "rpa",
    "playwright",
    "check-in",
    "avianca",
    "copa-airlines",
    "skyvern",
    "agencia-de-viajes",
    "automatizacion",
    "typescript"
  ],
  "homepage": "https://github.com/KevinAndrey96/typescript-playwright-airline-checkin-rpa#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KevinAndrey96/typescript-playwright-airline-checkin-rpa.git"
  },
  "license": "MIT",
  "author": "Kevin Andrey Herrera Silva <kahs_kevin@hotmail.com>",
  "type": "module",
  "bin": {
    "checkin": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:e2e"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "pino": "^10.4.0",
    "playwright": "1.65.1",
    "proper-lockfile": "^4.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.4",
    "@types/proper-lockfile": "^4.1.4",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
