# Skyvern API (servidor local en Docker)
SKYVERN_API_URL=http://localhost:8000/v1
SKYVERN_API_KEY=your_api_key_from_skyvern_ui_settings

# Tarea
SKYVERN_MAX_STEPS=50
SKYVERN_ENGINE=skyvern-2.0
SKYVERN_PROXY_LOCATION=NONE
SKYVERN_TASK_TIMEOUT_MS=1800000
SKYVERN_POLL_INTERVAL_MS=5000
SKYVERN_DELAY_BETWEEN_PASSENGERS=5000

# Logs
SKYVERN_LOG_LEVEL=info
SKYVERN_LOG_CONSOLE=true

# ── Copa workflow (modo recomendado) ──
# Publica el workflow en Skyvern UI y pega el wpid_ aquí
COPA_SKYVERN_MODE=workflow
COPA_SKYVERN_WORKFLOW_ID=
COPA_SKYVERN_RUN_WITH=code
COPA_SKYVERN_AI_FALLBACK=true

# Modo alternativo: task único con prompt largo (sin workflow)
# COPA_SKYVERN_MODE=task

# ── Configurar en el servidor Skyvern (~/Documents/skyvern/.env) ──
# LM Studio con Qwen2.5-VL-7B:
# OPENAI_COMPATIBLE_MODEL_NAME=qwen2.5-vl-7b-instruct
# OPENAI_COMPATIBLE_SUPPORTS_VISION=true
# OPENAI_COMPATIBLE_API_BASE=http://host.docker.internal:1234/v1
# LLM_KEY=OPENAI_COMPATIBLE
