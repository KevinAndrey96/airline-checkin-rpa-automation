# Manifiesto de pasajeros y carpeta donde se guardan los pasabordos
MANIFEST_PATH=data/passengers.csv
OUTPUT_DIR=boarding_passes
LOG_LEVEL=info

# Navegador (Avianca). Pon BROWSER_HEADLESS=false para ver el navegador en tu equipo.
BROWSER_HEADLESS=true
BROWSER_SLOW_MO_MS=0
STEP_TIMEOUT_MS=30000
NAVIGATION_TIMEOUT_MS=60000

# Reintentos de errores transitorios y pausa entre pasajeros
MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=5000
DELAY_BETWEEN_PASSENGERS_MS=5000

AVIANCA_CHECKIN_URL=https://checkinnew.avianca.com/Check-In?lang=Es

# Skyvern (Copa). La clave se crea en la interfaz de Skyvern, en Settings.
SKYVERN_API_URL=http://localhost:8000/v1
SKYVERN_API_KEY=
SKYVERN_ENGINE=skyvern-2.0
SKYVERN_PROXY_LOCATION=NONE
SKYVERN_MAX_STEPS=50
SKYVERN_POLL_INTERVAL_MS=5000
SKYVERN_RUN_TIMEOUT_MS=1800000

# COPA_MODE=task envía una tarea con instrucciones; workflow usa un workflow publicado (wpid_...)
COPA_CHECKIN_URL=https://checkin.copaair.com/
COPA_MODE=task
COPA_WORKFLOW_ID=
